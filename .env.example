APP_NAME="Kunuuzul Imam Kauman"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://kunuuzulimamkauman.net
APP_DOMAIN=kunuuzulimamkauman.net
SIAKAD_URL=https://siakad.kunuuzulimamkauman.net
PSB_URL=https://psb.kunuuzulimamkauman.net
SURAT_URL=https://surat.kunuuzulimamkauman.net
ALUMNI_URL=https://alumni.kunuuzulimamkauman.net
# Biarkan ASSET_URL kosong agar aset mengikuti host yang diakses (subdomain ikut benar).
# ASSET_URL="${APP_URL}"

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database: Railway MySQL (disarankan) ---
# Opsi 1: pakai DATABASE_URL dari plugin MySQL Railway, contoh:
# DATABASE_URL=mysql://root:password@mysql.railway.internal:3306/railway
# Opsi 2: isi satu per satu dari tab Variables Railway
DB_CONNECTION=mysql
DB_HOST=mysql.railway.internal
DB_PORT=3306
DB_DATABASE=railway
DB_USERNAME=root
DB_PASSWORD=
DATABASE_URL=
MYSQL_ATTR_SSL_CA=

BROADCAST_CONNECTION=log
CACHE_DRIVER=file
CACHE_STORE=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
# Ganti dengan email resmi pondok (dipakai notifikasi PPDB/kontak/konsultasi + reset password admin).
# Notifikasi bersifat best-effort: gagal kirim tidak menggagalkan simpan form.
MAIL_FROM_ADDRESS="noreply@kunuuzulimamkauman.net"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Reverb hanya bila butuh websocket realtime.
# Default broadcast log agar deploy Railway sederhana.
# Kalau butuh Reverb di Railway, jalankan service terpisah + isi ini:
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Cloudflare Turnstile - isi dari dash.cloudflare.com > Turnstile
# Kosong = verifikasi otomatis nonaktif (situs tetap jalan)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Search Console - isi token verifikasi (Search Console > Verifikasi > tag HTML).
# Contoh: GOOGLE_SITE_VERIFICATION=abc123... — memunculkan meta google-site-verification.
GOOGLE_SITE_VERIFICATION=

# --- Catatan deploy Railway ---
# 1. APP_KEY: kosongkan lalu generate sekali via: php artisan key:generate --show
#    paste hasilnya ke Variables Railway sebagai APP_KEY.
# 2. APP_URL: ganti dengan domain Railway (atau domain custom), harus https://
# 3. LOG_CHANNEL wajib stderr agar log muncul di Railway Logs.
# 4. Upload gambar pakai disk public (storage/app/public).
#    Filesystem Railway ephemeral: pasang Volume di /app/storage/app/public
#    atau pindah ke S3, kalau tidak file upload hilang tiap redeploy.
# 5. DB sqlite lokal tidak cocok untuk Railway, pakai plugin MySQL.
